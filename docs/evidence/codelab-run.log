# docs/codelab/qnx-tpm-measured-boot-qemu.md followed as written from a fresh clone, 2026-11-27
# QNX SDP 8.0, QEMU 10.2.1, swtpm, OVMF_CODE_4M.fd; KVM

## clone and build
+ git clone https://github.com/shiran-yu/witness-qnx witness
qcc -Vgcc_ntox86_64 -O2 -g -Wall -Wextra -Werror -std=gnu11 -D_QNX_SOURCE -fstack-protector-strong -D_FORTIFY_SOURCE=2 -o build/x86_64/dev-tpm-tis driver/main.c driver/tis.c
qcc -Vgcc_ntox86_64 -O2 -g -Wall -Wextra -Werror -std=gnu11 -D_QNX_SOURCE -fstack-protector-strong -D_FORTIFY_SOURCE=2 -o build/x86_64/tpm-raw tools/tpm-raw.c
qcc -Vgcc_ntox86_64 -O2 -g -Wall -Wextra -Werror -std=gnu11 -D_QNX_SOURCE -fstack-protector-strong -D_FORTIFY_SOURCE=2 -shared -fPIC -Wl,-soname,libtss2-tcti-witness.so.0 -o build/x86_64/libtss2-tcti-witness.so.0 tcti/tcti-witness.c
qcc -Vgcc_ntox86_64 -O2 -g -Wall -Wextra -Werror -std=gnu11 -D_QNX_SOURCE -fstack-protector-strong -D_FORTIFY_SOURCE=2 -Ilib -o build/x86_64/witness-measure tools/witness-measure.c lib/sha256.c
qcc -Vgcc_ntox86_64 -O2 -g -Wall -Wextra -Werror -std=gnu11 -D_QNX_SOURCE -fstack-protector-strong -D_FORTIFY_SOURCE=2 -o build/x86_64/witnessd agent/witnessd.c -ltss2-esys -ltss2-mu -ltss2-rc -ltss2-tctildr -lsocket
qcc -Vgcc_ntox86_64 -O2 -g -Wall -Wextra -Werror -std=gnu11 -D_QNX_SOURCE -fstack-protector-strong -D_FORTIFY_SOURCE=2 -o build/x86_64/rt-probe tools/rt-probe.c

