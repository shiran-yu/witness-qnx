# Files measured into PCR 8 right after the system partition is mounted, before any of them runs.
# This manifest lives in the IFS, so on UEFI targets the firmware's PCR 4 measurement covers it too:
# an attacker cannot drop a file from the list without changing PCR 4.
/system/bin/sshd
/system/etc/ssh/sshd_config
/system/etc/startup/post_startup.sh
/system/bin/start_net.sh
/system/bin/tabrm
/system/lib/libtss2-tcti-witness.so.0
/system/lib/libtss2-esys.so.1
/system/lib/libtss2-sys.so.1
/system/lib/libtss2-mu.so.1
/system/lib/libtss2-tctildr.so.1
/system/lib/libtcti_tabrm.so.1
/system/lib/dll/tabrm_rm_mod_intel.so
/system/etc/witness/tabrm.cfg
